# ===== RPA Worker 配置（复制为 .env.local 后填写）=====

# 后端地址（部署后端的服务器）
BACKEND_URL=http://127.0.0.1:8000

# 与后端 .env 的 RPA_API_KEY 完全一致
# 生成方式：python -c "import secrets;print(secrets.token_hex(16))"
RPA_API_KEY=

# Worker 标识不用填。进程会在本目录生成 .worker_id 并一直沿用。

# 店铺账号标识。授权页已绑定时可留空，run_assigned.py 会用绑定里的 rpa_account。
# 未绑定时必填，且要与矩阵账号的 rpa_account 一致。
ACCOUNT=my-shop

# 浏览器：local 使用本机 profiles/；adspower 用指纹浏览器隔离，Playwright 只负责操作
BROWSER_PROVIDER=local
ADSPOWER_API_BASE=http://127.0.0.1:50325
ADSPOWER_API_KEY=
ADSPOWER_PROFILE_ID=

# 平台：douyin（飞鸽后台，抖店商家） | douyin_enterprise（企业号后台 e.douyin.com，蓝V 无抖店） | douyin_laike（来客商家后台 life.douyin.com，本地生活） | xiaohongshu（千帆后台）
# 注：douyin_enterprise / douyin_laike 上报后端时归 douyin 渠道。
# 频控按账号页指定的形态；账号未指定时用后端 DOUYIN_ACCOUNT_TYPE 全局默认
PLATFORM=douyin

# 平台后台入口地址覆盖（留空用内置默认；平台改地址时在此覆盖，无需改代码）
# 飞鸽默认 https://im.jinritemai.com/pc_seller_v2/main/workspace
# 企业号默认 https://e.douyin.com/（消息管理页确切路径冒烟确认后在此固化）
# 来客默认 https://life.douyin.com/（消息/客服管理页确切路径冒烟确认后在此固化）
# 千帆默认 https://ark.xiaohongshu.com/ark/message/platform/msg
PLATFORM_URL=

# 无头模式：生产 true（Windows 锁屏也不影响）；调试页面时 false
HEADLESS=true

# 浏览器登录态目录（每个 account 独立）
PROFILE_DIR=./profiles

# 轮询间隔（秒）：outbox 拉取 / 入站监听
POLL_INTERVAL=2
# 心跳间隔（秒）
HEARTBEAT_INTERVAL=10

# 本地状态库（身份缓存 + 消息去重）
STATE_DB=./worker_state.db
# 待发媒体下载目录
DOWNLOAD_DIR=./downloads
