# ===== 公网域名（记在这里备查，后端会忽略；证书和反代由宝塔做）=====
# 现有网站，不要新建站点。不要带 https:// 和路径。
# 客服系统挂在子目录 /cs/，工作台为 https://www.cndistribution.com/cs/
SITE_DOMAIN=www.cndistribution.com

# ===== 基础 =====
APP_NAME=multi-platform-cs-agent
# 本地开发保持 development。Docker Compose 会强制 APP_ENV=production，
# 这样已修改的管理员密码不会在每次重启时被重置为 admin123。
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
# Docker Compose 的 environment.DATABASE_URL 会覆盖本项，默认是卷上的 SQLite。
# 换 PostgreSQL 必须改 docker-compose.yml，并安装 psycopg2-binary。见 docs/deployment.md。
# DATABASE_URL=postgresql+psycopg2://postgres:<密码>@<数据库主机>:5432/cs_agent
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ===== 安全基线（Phase 8）=====
# 跨域白名单（逗号分隔）。空 = 仅放行同源请求（经 nginx/vite 代理部署时保持为空即可）；
# 前后端分离部署时配置，如 CORS_ORIGINS=https://ops.example.com
CORS_ORIGINS=
# Mock 通道开关（/api/mock/incoming 无鉴权注入口）。开发/演示环境 true，生产必须 false
MOCK_ENABLED=true

# ===== LLM（OpenAI 兼容接口，默认 DeepSeek）=====
LLM_BASE_URL=https://api.ofox.ai/v1
LLM_API_KEY= xxxx
LLM_MODEL=gpt-4o-mini
# Token 单价（元/千 tokens，用于看板成本估算；0 = 不估算）
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0

# ===== Embedding / Reranker（OpenAI 兼容接口，默认硅基流动）=====
# 不配置则 RAG 自动降级为纯 BM25 检索
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Rerank 最高分低于该阈值判定为无命中（触发转人工）
RAG_RERANK_THRESHOLD=0.35
# 高置信快路径：精排最高分 ≥ 该阈值且候选 ≤2 条时跳过 judge 相关性 LLM（省 3-8 秒/条）；
# faithfulness/证据核对护栏不变。0 = 关闭快路径
RAG_JUDGE_SKIP_SCORE=0.9

# ===== 抖音开放平台（不配置则发送降级为日志输出）=====
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_ACCESS_TOKEN=

# ===== 小红书开放平台（不配置则发送降级为日志输出）=====
# 准入：蓝 V 专业号 + 商业开放平台应用 + 聚光「三方客服管理」授权（见 docs/platform-integration.md）
# accessToken 有效期约 7 天、refreshToken 约 14~30 天（以返回的 expiresAt 为准）；
# 系统每 10 分钟检查并自动刷新、落 platform_tokens 表（重启不丢失），无需人工干预；
# refreshToken 过期需重新授权：python scripts/xhs_oauth.py exchange --code <新code> --write-env
XHS_APP_ID=
XHS_APP_SECRET=
XHS_ACCESS_TOKEN=
XHS_REFRESH_TOKEN=

# ===== 拟人化发送 =====
HUMANIZE_BASE_DELAY_MS=800
HUMANIZE_PER_CHAR_MS=60

# ===== 会话超时自动关闭（仅 AI 接待中的会话）=====
SESSION_TIMEOUT_MINUTES=30
SESSION_CLOSE_MESSAGE=或者您方便加下vx吗，把办理的流程和需要的资料发您vx上，您可以先接收参考下，后续有不清楚的也方便给您直接解答下您可以先接收参考下，后续
SESSION_SWEEP_INTERVAL_SECONDS=300

# ===== 告警（钉钉/企微机器人 webhook，留空则只记日志）=====
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=600

# ===== 备用 LLM（主模型故障时热备切换，OpenAI 兼容，留空不启用）=====
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ===== 自动备份 =====
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# ===== 知你快回插件（网页版抖音/小红书私信，见 docs/platform-integration.md）=====
# 插件「自己的回复接口」密钥。留空则接口返回 503。
# 生成：python -c "import secrets;print(secrets.token_hex(16))"
ZHINI_REPLY_API_KEY=

# ===== RPA 通道（无官方 API 资质时的降级方案，见 docs/rpa-workers.md）=====
# Worker 鉴权密钥，可用命令生成：python -c "import secrets;print(secrets.token_hex(16))"
RPA_API_KEY=
# 各平台出站通道：api（官方 API）| rpa（RPA Worker）
DOUYIN_CHANNEL=rpa
XHS_CHANNEL=rpa
# 抖音账号形态的全局默认：feige（抖店商家）| enterprise（蓝V 企业号，RPA 频控 48h/6 条）| laike（来客商家，本地生活，初期对齐企业号规则）
# 账号页单独指定后以账号为准；这里只作用于未指定形态的抖音账号
DOUYIN_ACCOUNT_TYPE=feige
RPA_OUTBOX_LEASE_SECONDS=60
RPA_WORKER_OFFLINE_SECONDS=90
RPA_MEDIA_RETENTION_DAYS=30

# ===== 语音转写（OpenAI 兼容 /audio/transcriptions，留空禁用；如 Whisper / SenseVoice）=====
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

# ===== 图片理解（OpenAI 兼容视觉模型，留空禁用；base_url/key 留空时复用主 LLM 配置）=====
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
